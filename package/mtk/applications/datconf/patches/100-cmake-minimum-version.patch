From: TR3000 adaptation maintainers
Subject: [PATCH] cmake: require supported compatibility policies

CMake 4 in the v25.12 build tools removed compatibility with policies older
than 3.5. The project uses no legacy policy overrides.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,4 +1,4 @@
-cmake_minimum_required(VERSION 2.6)
+cmake_minimum_required(VERSION 3.5)
 
 set(DATCONF_VERSION_MAJOR 1)
 set(DATCONF_VERSION_MINOR 0)
--- a/kvcutil/CMakeLists.txt
+++ b/kvcutil/CMakeLists.txt
@@ -1,4 +1,4 @@
-cmake_minimum_required(VERSION 2.6)
+cmake_minimum_required(VERSION 3.5)
 
 project(kvcutil)
 
--- a/datconf/CMakeLists.txt
+++ b/datconf/CMakeLists.txt
@@ -1,4 +1,4 @@
-cmake_minimum_required(VERSION 2.6)
+cmake_minimum_required(VERSION 3.5)
 
 project(datconf)
 
--- a/datconf/lua/CMakeLists.txt
+++ b/datconf/lua/CMakeLists.txt
@@ -1,4 +1,4 @@
-cmake_minimum_required(VERSION 2.6)
+cmake_minimum_required(VERSION 3.5)
 
 project(datconf-lua)
 
